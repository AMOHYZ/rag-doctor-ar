# Copy to .env (git-ignored). Everything is optional: defaults run fully local via Ollama.

# ollama (default) | openai | anthropic
LLM_PROVIDER=ollama
# Model for answering. Defaults: qwen3:8b (ollama), gpt-4o-mini (openai), claude-haiku-5-5 (anthropic)
LLM_MODEL=
# Model for the LLM judge. Defaults to the same provider/model as above.
JUDGE_PROVIDER=
JUDGE_MODEL=

# Embeddings always run locally through Ollama.
EMBED_MODEL=bge-m3
OLLAMA_HOST=http://localhost:11434

# Only needed for the optional hosted providers. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
